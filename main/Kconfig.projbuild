menu "Application Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    menu "Modbus"

        menu "RTU Slave"
            help
                This meter as an RS485 Modbus RTU slave (upstream SCADA/PLC).

            config APP_MB_SLAVE_ADDR
                hex "Slave unit ID"
                range 0x01 0xF7
                default 0x0A
                help
                    RTU unit ID of this energy meter (common factory default 0x0A).

            config APP_MB_SLAVE_UART_PORT
                int "UART port"
                range 0 2
                default 1
                help
                    UART port used for the RS485 Modbus slave.

            config APP_MB_SLAVE_RXD_GPIO
                int "RXD GPIO"
                range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
                default 13
                help
                    RS485 RX GPIO for Modbus slave.

            config APP_MB_SLAVE_TXD_GPIO
                int "TXD GPIO"
                range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
                default 14
                help
                    RS485 TX GPIO for Modbus slave.

            config APP_MB_SLAVE_TASK_STACK_SIZE
                int "Task stack size"
                range 3072 16384
                default 4096
                help
                    Stack size for Modbus slave event task.

            config APP_MB_SLAVE_TASK_PRIORITY
                int "Task priority"
                range 1 20
                default 7
                help
                    Priority for Modbus slave event task.
        endmenu

        menu "RTU Master"
            help
                Downstream RS485 master (poll PM710 / EM-07K). The master task is
                always built; whether it actually polls the bus is controlled by
                the bus-enable flag in NVS (LCD / Web Portal / console):
                  - NVS mb_enabled = off  → task idle, no polling
                  - NVS mb_enabled = on   → polls every configured slot

            config APP_MB_MASTER_UART_PORT
                int "UART port"
                range 0 2
                default 2
                help
                    UART port for the Modbus RTU master RS485 bus.

            config APP_MB_MASTER_RXD_GPIO
                int "RXD GPIO"
                range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
                default 11
                help
                    RS485 RX GPIO for Modbus master.

            config APP_MB_MASTER_TXD_GPIO
                int "TXD GPIO"
                range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
                default 12
                help
                    RS485 TX GPIO for Modbus master.

            config APP_MB_MASTER_POLL_PERIOD_MS_DEFAULT
                int "Default poll period (ms)"
                range 200 60000
                default 2000
                help
                    Full poll-cycle period on first boot / factory default.
                    Runtime configurable (NVS / LCD / Web Portal).

            config APP_MB_MASTER_TASK_STACK_SIZE
                int "Task stack size"
                range 3072 16384
                default 4096
                help
                    Stack size for the Modbus master poll task.

            config APP_MB_MASTER_TASK_PRIORITY
                int "Task priority"
                range 1 20
                default 6
                help
                    Priority for the Modbus master poll task.
        endmenu

        menu "TCP Server"
            help
                Modbus TCP server (this meter on Ethernet/Wi-Fi). Service is
                not implemented yet — options reserve defaults for later.

            config APP_MB_TCP_ENABLE
                bool "Enable Modbus TCP server (future)"
                default n
                help
                    Placeholder. When the TCP server is implemented this builds
                    and starts it. Keep off until the backend exists.

            config APP_MB_TCP_UNIT_ID
                hex "TCP unit ID"
                range 0x01 0xF7
                default 0x0A
                depends on APP_MB_TCP_ENABLE
                help
                    Modbus unit identifier on TCP (often matches RTU slave ID).

            config APP_MB_TCP_PORT
                int "TCP listen port"
                range 1 65535
                default 502
                depends on APP_MB_TCP_ENABLE
                help
                    Standard Modbus TCP port is 502.

            config APP_MB_TCP_TASK_STACK_SIZE
                int "Task stack size"
                range 3072 16384
                default 4096
                depends on APP_MB_TCP_ENABLE
                help
                    Reserved stack size for the future TCP server task.

            config APP_MB_TCP_TASK_PRIORITY
                int "Task priority"
                range 1 20
                default 5
                depends on APP_MB_TCP_ENABLE
                help
                    Reserved priority for the future TCP server task.
        endmenu

    endmenu

    menu "I2C"

        config APP_I2C_PORT_NUM
            int "I2C port number"
            range 0 1
            default 0
            help
                I2C master port number.

        config APP_I2C_SDA_IO
            int "I2C SDA GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 1
            help
                GPIO number for I2C SDA.

        config APP_I2C_SCL_IO
            int "I2C SCL GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 2
            help
                GPIO number for I2C SCL.

        config APP_I2C_CLK_SPEED_HZ
            int "I2C clock speed"
            range 10000 400000
            default 100000
            help
                I2C clock speed in Hz.

    endmenu

    menu "PCF8574"

        config APP_PCF8574_I2C_ADDR
            hex "PCF8574 I2C address"
            range 0x20 0x27
            default 0x20
            help
                PCF8574 7-bit I2C address.

        config APP_PCF8574_INT_GPIO
            int "PCF8574 INT GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 10
            help
                ESP32 GPIO connected to PCF8574 INT pin.

        config APP_PCF8574_W5500_RST_PIN
            int "PCF8574 pin driving W5500 RESETn"
            range 0 7
            default 0
            help
                PCF8574 port bit wired to the W5500 RESETn net. Must match the
                schematic: if RESETn is on another bit, the reset pulse is
                issued on the wrong pin and W5500 probing fails intermittently.

        config APP_PCF8574_IN0_PIN
            int "PCF8574 pin for digital input 0"
            range 0 7
            default 5
            help
                PCF8574 port bit wired to digital input 0.

        config APP_PCF8574_IN1_PIN
            int "PCF8574 pin for digital input 1"
            range 0 7
            default 2
            help
                PCF8574 port bit wired to digital input 1.

        config APP_PCF8574_OUT0_PIN
            int "PCF8574 pin for digital output 0"
            range 0 7
            default 7
            help
                PCF8574 port bit wired to digital/relay output 0.

        config APP_PCF8574_OUT1_PIN
            int "PCF8574 pin for digital output 1"
            range 0 7
            default 6
            help
                PCF8574 port bit wired to digital/relay output 1.

        config APP_IO_EXPANDER_DEBUG
            bool "Verbose IO expander / W5500 reset diagnostics"
            default n
            help
                Logs a hardware port readback and the measured RESETn rise time
                around every W5500 reset pulse. Off by default now that the reset
                path is confirmed; the pulse itself is identical either way. The
                "ioexp" console command works regardless of this setting, so
                enable this only when a boot-time trace is needed.

        config APP_IO_EXPANDER_TASK_STACK_SIZE
            int "IO expander task stack size"
            range 1024 16384
            default 3072
            help
                Defines stack size for IO expander task.

        config APP_IO_EXPANDER_TASK_PRIORITY
            int "IO expander task priority"
            range 1 20
            default 6
            help
                Defines priority for IO expander task.

    endmenu

    menu "HMI"

        config APP_HMI_TEST_ENABLE
            bool "Enable HMI bring-up test task"
            default y
            help
                Starts the LCD2004/buttons/LEDs/buzzer hardware test task.

        config APP_HMI_LCD2004_I2C_ADDR
            hex "LCD2004 I2C backpack address"
            range 0x20 0x27
            default 0x27
            help
                PCF8574 backpack 7-bit I2C address for LCD2004.

        config APP_HMI_PCF8575_I2C_ADDR
            hex "HMI PCF8575 I2C address"
            range 0x20 0x27
            default 0x21
            help
                PCF8575 7-bit I2C address for HMI buttons, LEDs, and buzzer.

        config APP_HMI_TASK_STACK_SIZE
            int "HMI test task stack size"
            range 2048 16384
            default 4096
            help
                Stack size for the HMI test task.

        config APP_HMI_TASK_PRIORITY
            int "HMI test task priority"
            range 1 20
            default 5
            help
                Priority for the HMI test task.

        config APP_HMI_BUZZER_CLICK_MS
            int "HMI buzzer click duration in milliseconds"
            range 0 1000
            default 500
            help
                Duration of the active buzzer click on each button press. Set to 0 to disable the click effect.

        config APP_HMI_BUTTON_ACTIVE_LOW
            bool "HMI buttons are active-low"
            default y
            help
                Select if pressed buttons pull PCF8575 input pins low.

        config APP_HMI_LED_ACTIVE_HIGH
            bool "HMI LEDs are active-high"
            default n
            help
                Select if PCF8575 output high turns an LED on. Leave disabled for
                active-low LEDs (PCF8575 output low turns an LED on).

        config APP_HMI_BUZZER_ACTIVE_HIGH
            bool "HMI buzzer is active-high"
            default y
            help
                Select if PCF8575 output high drives the buzzer. Leave disabled for
                an active-low buzzer (PCF8575 output low sounds the buzzer).

    endmenu

    menu "ATM90E32AS Energy Meter"

        config APP_SHARED_SPI_HOST
            int "Shared SPI host"
            range 1 2
            default 1
            help
                SPI host used by ATM90E32AS and SD card.

        config APP_SHARED_SPI_MISO_GPIO
            int "Shared SPI MISO GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 16
            help
                Shared SPI MISO GPIO.

        config APP_SHARED_SPI_SCLK_GPIO
            int "Shared SPI SCLK GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 17
            help
                Shared SPI SCLK GPIO.

        config APP_SHARED_SPI_MOSI_GPIO
            int "Shared SPI MOSI GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 18
            help
                Shared SPI MOSI GPIO.

        config APP_ATM90E32AS_CS_GPIO
            int "ATM90E32AS CS GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 38
            help
                Chip select GPIO for ATM90E32AS.

        config APP_ATM90E32AS_IRQ2_GPIO
            int "ATM90E32AS IRQ2 GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 39
            help
                IRQ2 input GPIO from ATM90E32AS.

        config APP_ATM90E32AS_IRQ1_GPIO
            int "ATM90E32AS IRQ1 GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 40
            help
                IRQ1 input GPIO from ATM90E32AS.

        config APP_ATM90E32AS_WARN_GPIO
            int "ATM90E32AS WARN_OUT GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 41
            help
                WARN_OUT input GPIO from ATM90E32AS.

        config APP_ATM90E32AS_MODE_SEL_GPIO
            int "ATM90E32AS mode select GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 21
            help
                Selects 3P3W high or 3P4W low.

        config APP_ATM90E32AS_DEFAULT_MODE_3P3W
            bool "Default wiring: 3-phase 3-wire mode"
            default n
            help
                Initial wiring mode used only on first boot when no calibration
                is saved in NVS. 3P3W drives the mode-select relay high; disabled
                means 3P4W. Once a wiring mode is set and saved from the console
                (meter-cal set --field wiring ... / save), the NVS value overrides
                this default on every subsequent boot.

        menu "ATM90E32AS Parameters"
            comment "Build-time defaults for first boot / factory calib (NVS overrides when present)"

            choice APP_ATM90E32AS_DEFAULT_PGA
                prompt "Fallback current PGA (no CT config)"
                default APP_ATM90E32AS_DEFAULT_PGA_1X
                help
                    Used only when CT-based PGA auto-select cannot run (e.g. missing
                    CT params). Normal path: Current CT Apply recomputes PGA from
                    NCT / I Rated / I Expected and R_BURDEN. A saved NVS calib still
                    restores its stored PGA on boot until the next CT Apply.

                config APP_ATM90E32AS_DEFAULT_PGA_1X
                    bool "x1"
                config APP_ATM90E32AS_DEFAULT_PGA_2X
                    bool "x2"
                config APP_ATM90E32AS_DEFAULT_PGA_4X
                    bool "x4"
            endchoice

            choice APP_ATM90E32AS_DEFAULT_LINE_FREQ
                prompt "Default grid frequency"
                default APP_ATM90E32AS_DEFAULT_LINE_FREQ_50HZ
                help
                    Line frequency used when no calibration is saved in NVS.
                    A saved calibration overrides this on later boots.

                config APP_ATM90E32AS_DEFAULT_LINE_FREQ_50HZ
                    bool "50 Hz"
                config APP_ATM90E32AS_DEFAULT_LINE_FREQ_60HZ
                    bool "60 Hz"
            endchoice

            comment "Current transformer (CT) — factory U/I gain is IC default 0x8000"

            config APP_ATM90E32AS_R_BURDEN_MOHM
                int "CT burden resistance (mohm)"
                range 100 50000
                default 4400
                help
                    Fixed board burden resistor in milliohms (4400 = 4.4 ohm).
                    Build-time only — not stored in NVS. Used with VADC limit
                    720 mVrms for PGA auto-select: Ilim = 0.72 * NCT / (R * PGA).

            config APP_ATM90E32AS_CT_RATIO
                int "Default CT ratio NCT (primary:1)"
                range 1000 6000
                default 2000
                help
                    Default CT turns ratio NCT (primary amps : 1 A secondary).
                    Allowed range 1000..6000 in steps of 100 (LCD edit).
                    Example 2000:1. Persisted in config_manager; operator can
                    change via LCD Current CT.

            config APP_ATM90E32AS_I_RATED_A
                int "Default CT rated primary current (A)"
                range 1 10000
                default 100
                help
                    CT nameplate primary current (A). Used when selecting PGA so
                    rated current stays inside the ADC window.

            config APP_ATM90E32AS_I_EXPECTED_A
                int "Default expected max primary current (A)"
                range 1 10000
                default 75
                help
                    Operator expected maximum primary current (A). After CT Apply
                    this becomes the true measurement range (0..I_Expected), and
                    may be clamped down to Ilim of the selected PGA.

        endmenu

        config APP_ATM90E32AS_SPI_CLOCK_HZ
            int "ATM90E32AS SPI clock Hz"
            range 100000 2000000
            default 200000
            help
                ATM90E32AS SPI clock. Use low speed during bring-up.

        config APP_ENERGY_METER_TASK_STACK_SIZE
            int "Energy meter task stack size"
            range 4096 16384
            default 4096
            help
                Defines stack size for energy meter task.

        config APP_ENERGY_METER_TASK_PRIORITY
            int "Energy meter task priority"
            range 1 20
            default 6
            help
                Defines priority for energy meter task.

        config APP_ENERGY_METER_POLL_PERIOD_MS
            int "Energy meter poll period ms"
            range 200 60000
            default 1000
            help
                Period between ATM90E32AS measurement reads.

        config APP_ENERGY_METER_LOG_EACH_SAMPLE
            bool "Log each ATM90E32AS sample"
            default n
            help
                Print every measurement to console. Disable to keep console shell clean.

    endmenu

    menu "SD Card"
        comment "SD shares the ATM90 SPI bus (host/MISO/SCLK/MOSI under ATM90E32AS Energy Meter)"

        config APP_SD_CS_GPIO
            int "SD card CS GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 8
            help
                SD card chip select GPIO on shared SPI bus.

        config APP_SD_DET_GPIO
            int "SD card detect GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 15
            help
                SD card detect input GPIO with pull-up.

        config APP_SD_ENABLE_LFN
            bool "Enable long filename support for SD card"
            default y
            help
                Enable FatFS long filename (LFN) support for SD card operations.
                When enabled, allows filenames longer than 8.3 format (e.g.,
                "calib_001.dat" instead of just "cal_001.bin"). Uses ~512 bytes
                of heap per concurrent file operation. Disable only if RAM is
                critically constrained and all filenames follow strict 8.3 format.

    endmenu

    menu "Console / Debug"

        config APP_CONSOLE_ENABLE
            bool "Enable developer console"
            default y
            help
                Start esp_console REPL for calibration, config, and debug commands.

        config APP_CONSOLE_PROMPT
            string "Console prompt"
            default "dev@meter:~$ "
            help
                Prompt string for the developer console (e.g. "dev@meter:~$ ").

        config APP_CONSOLE_MAX_CMDLINE_LENGTH
            int "Console max command line length"
            range 128 2048
            default 512
            help
                Maximum command line length for the console.

        config APP_CONSOLE_AUTH_ENABLE
            bool "Require login for the console"
            default y
            help
                Gate the developer console behind a username/password prompt.
                This is a developer tool, so login is enabled by default to keep
                end users out. Authentication is cleartext over the serial link;
                it deters casual access, it is not a cryptographic safeguard.

        config APP_CONSOLE_AUTH_USERNAME
            string "Console login username"
            depends on APP_CONSOLE_AUTH_ENABLE
            default "admin"
            help
                Username required to unlock the developer console.

        config APP_CONSOLE_AUTH_PASSWORD
            string "Console login password"
            depends on APP_CONSOLE_AUTH_ENABLE
            default "admin"
            help
                Password required to unlock the developer console. Change this
                before shipping devices.

        config APP_CONSOLE_AUTH_MAX_ATTEMPTS
            int "Console login attempts before lockout"
            depends on APP_CONSOLE_AUTH_ENABLE
            range 1 10
            default 3
            help
                Number of failed login attempts allowed before the console
                blocks further attempts until reboot.

        menu "Temporary debug aids"
            comment "Leave off for release builds"

            config APP_STATUS_DEBUG
                bool "System status debug (temporary)"
                default n
                help
                    Temporary debug aid for testing the System Status Manager. When on,
                    system_status_set() logs a line on every real state transition
                    (OLD -> NEW) and system_status_dump() prints the full table. Leave
                    off for release builds: no logs, no dump, no effect.

            config APP_DP_DEBUG
                bool "Data Point Layer debug console command (temporary)"
                default n
                help
                    Temporary test harness for the Data Point Layer. When on, the
                    developer console gains a "dp" command that calls
                    data_point_read()/data_point_write() directly so the CFG_* mapping
                    can be exercised before any protocol is wired to it.

                    This is measurement scaffolding, not a product feature. It can print
                    configured passwords (CFG_WIFI_PASS / CFG_MQTT_PASS) in cleartext on
                    the serial console. Leave off for release builds.

        endmenu

    endmenu

    menu "WiFi Meter Server"

        config APP_WIFI_METER_AP_SSID
            string "WiFi meter AP SSID"
            default "PowerMeter-AP"
            help
                SSID for local AP serving ATM90E32AS measurements.

        config APP_WIFI_METER_AP_PASSWORD
            string "WiFi meter AP password"
            default "12345678"
            help
                Password for local AP. Empty string means open AP.

        config APP_WIFI_METER_AP_CHANNEL
            int "WiFi meter AP channel"
            range 1 13
            default 6
            help
                WiFi AP channel.

        config APP_WIFI_METER_AP_MAX_CONN
            int "WiFi meter AP max connections"
            range 1 8
            default 4
            help
                Maximum AP client connections.

        config APP_WIFI_METER_HTTP_PORT
            int "WiFi meter HTTP port"
            range 1 65535
            default 80
            help
                HTTP server port for measurement endpoint.

        config APP_WIFI_METER_STA_SSID
            string "WiFi STA SSID"
            default ""
            help
                Router SSID for periodic upload.

        config APP_WIFI_METER_STA_PASSWORD
            string "WiFi STA password"
            default ""
            help
                Router password for periodic upload.

        config APP_WIFI_METER_UPLOAD_ENABLE
            bool "Enable periodic upload"
            default n
            help
                Periodically upload latest meter JSON to server.

        config APP_WIFI_METER_UPLOAD_URL
            string "Upload URL"
            default ""
            help
                HTTP server URL for periodic POST upload.

        config APP_WIFI_METER_UPLOAD_PERIOD_MS
            int "Upload period ms"
            range 1000 600000
            default 5000
            help
                Period between upload attempts.

        config APP_WIFI_METER_UPLOAD_TIMEOUT_MS
            int "Upload timeout ms"
            range 1000 60000
            default 5000
            help
                HTTP client timeout for upload.

        config APP_WIFI_METER_UPLOAD_TASK_STACK_SIZE
            int "Upload task stack size"
            range 3072 16384
            default 4096
            help
                Stack size for WiFi upload task.

        config APP_WIFI_METER_UPLOAD_TASK_PRIORITY
            int "Upload task priority"
            range 1 20
            default 5
            help
                Priority for WiFi upload task.

    endmenu

    menu "Network Communication"

        config APP_W5500_SPI_HOST
            int "W5500 SPI host"
            range 1 2
            default 2
            help
                SPI host used by W5500.

        config APP_W5500_SPI_MOSI_GPIO
            int "W5500 SPI MOSI GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 5
            help
                GPIO number for W5500 SPI MOSI.

        config APP_W5500_SPI_MISO_GPIO
            int "W5500 SPI MISO GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 6
            help
                GPIO number for W5500 SPI MISO.

        config APP_W5500_SPI_SCLK_GPIO
            int "W5500 SPI SCLK GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 7
            help
                GPIO number for W5500 SPI SCLK.

        config APP_W5500_SPI_CS_GPIO
            int "W5500 SPI CS GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 9
            help
                GPIO number for W5500 SPI CS.

        config APP_W5500_INT_GPIO
            int "W5500 INT GPIO"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 4
            help
                GPIO number for W5500 interrupt.

        config APP_W5500_RESET_ACTIVE_LOW
            bool "W5500 RESETn is active low"
            default y
            help
                Level driven on the PCF8574 reset bit to assert reset. Enabled
                means reset is asserted by driving the bit low, which matches a
                W5500 wired directly to the expander. Disable only if an
                inverting buffer sits between the expander and the W5500.

        config APP_W5500_RESET_ASSERT_MS
            int "W5500 reset assert duration in milliseconds"
            range 1 1000
            default 10
            help
                How long RESETn is held asserted. The W5500's documented minimum
                RSTn pulse width is well under 1ms, so 10ms is an order of
                magnitude of margin and saves 90ms of boot time versus the old
                100ms. Do not shorten below 2ms: the expander's weak pull-up
                needs about 2ms just to move the line on this board, so a
                shorter assert risks a pulse the W5500 never sees.

        config APP_W5500_RESET_SETTLE_MS
            int "W5500 post-reset settle time in milliseconds"
            range 1 2000
            default 60
            help
                Delay after releasing RESETn before the first SPI access. Must
                cover the roughly 2ms the PCF8574's weak pull-up takes to raise
                RESETn on this board, plus the W5500's internal startup and PLL
                lock. 60ms is generous for both while cutting 190ms off boot
                versus the old 250ms. The real safety net for a slow-starting
                chip is APP_W5500_SW_RESET_TIMEOUT_MS below, not this delay.

        config APP_W5500_SPI_CLOCK_MHZ
            int "W5500 SPI clock MHz"
            range 1 40
            default 20
            help
                SPI clock for W5500 in MHz. 20 is far above what 100Mbps needs and
                leaves plenty of timing margin for headers and longer traces. On
                ESP32-S3 the GPIO matrix behaves the same as IOMUX at these
                frequencies, so running the W5500 on SPI3 is not a penalty. 40 also
                divides exactly from the 80MHz APB clock if you want to try it, but
                it was measured to make no difference to boot reliability here.

        config APP_W5500_SW_RESET_TIMEOUT_MS
            int "W5500 software reset / version poll timeout in milliseconds"
            range 100 3000
            default 1000
            help
                Window the esp_eth W5500 MAC uses to poll both the MR reset bit
                and VERSIONR. ESP-IDF's own driver notes that some W5500 units
                return version 0x00 when read right after reset, and the default
                of 100ms allows only 10 attempts before giving up with
                ESP_ERR_INVALID_VERSION. 1000ms gives 100 attempts. This costs
                nothing on a healthy boot because the loop exits on the first
                successful read.

        config APP_NETWORK_COMM_TASK_STACK_SIZE
            int "Network communication task stack size"
            range 3072 16384
            default 4096
            help
                Defines stack size for network communication task.

        config APP_NETWORK_COMM_TASK_PRIORITY
            int "Network communication task priority"
            range 1 20
            default 5
            help
                Defines priority for network communication task.

        config APP_NETWORK_PING_PERIOD_MS
            int "Network ping period ms"
            range 1000 60000
            default 5000
            help
                Period between ping sessions.

        config APP_NET_ETH_LINK_TIMEOUT_MS
            int "Ethernet link-up timeout ms"
            range 1000 30000
            default 5000
            help
                How long network_manager waits for the Ethernet PHY link after
                boot before falling back to WiFi STA (AUTO mode).

        config APP_NET_ETH_DHCP_TIMEOUT_MS
            int "Ethernet DHCP timeout ms"
            range 1000 60000
            default 10000
            help
                How long to wait for an Ethernet IP after link-up before
                treating it as a failure.

        config APP_NET_ETH_DHCP_WARN_S
            int "Ethernet no-IP warning after link up (s)"
            range 3 120
            default 15
            help
                After the Ethernet link comes up, if no IP has been obtained
                within this many seconds, ethernet_driver logs the DHCP client
                state. This tells apart "DISCOVER was sent and nothing replied"
                (network/router side) from "the DHCP client never started"
                (firmware side). 15s covers lwIP's first few DISCOVER retries,
                which back off at roughly 2s, 4s, 8s.

        config APP_NET_ETH_DOWN_DEBOUNCE_MS
            int "Ethernet link-down debounce ms"
            range 0 30000
            default 3000
            help
                How long the Ethernet link must stay down before failing over to
                WiFi STA. Debounces cable jitter and brief link drops.

        config APP_NET_STA_RETRY_MAX
            int "WiFi STA connect retries before AP fallback"
            range 1 20
            default 5
            help
                Number of STA connect attempts (after Ethernet is unavailable)
                before entering auto-AP recovery mode.

        config APP_NET_AP_RECOVERY_GRACE_MS
            int "Auto-AP recovery grace period ms"
            range 0 600000
            default 60000
            help
                After auto-AP recovery has started, how long to keep the SoftAP up
                once a data path (Ethernet or STA) returns, before stopping the AP
                and switching back. Gives a user time to finish configuring over AP.

        config APP_NET_AP_IDLE_TIMEOUT_MS
            int "Config portal AP idle auto-stop ms"
            range 5000 600000
            default 60000
            help
                After the user-launched config portal SoftAP has been up without any
                station associated, stop it automatically and reconnect the STA.
                No effect on the legacy auto-AP recovery path.

    endmenu

    menu "MQTT Client"

        config APP_MQTT_ENABLE
            bool "Enable MQTT client"
            default y
            help
                Build the MQTT telemetry/control client. When disabled, no MQTT
                task is started. Runtime on/off is controlled separately by the
                enabled flag in the active broker profile (NVS).

        config APP_MQTT_PUBLISH_PERIOD_MS
            int "Default telemetry publish period ms"
            range 1000 600000
            default 5000
            help
                Default period between telemetry publishes. This is only the
                first-boot default; the runtime value lives in NVS
                (config_mqtt_t.publish_period_ms) and can be changed without a
                rebuild.

        config APP_MQTT_TASK_STACK_SIZE
            int "MQTT manager task stack size"
            range 4096 16384
            default 6144
            help
                Stack for the MQTT manager task. TLS handshakes need a large
                stack; keep at least 6144 when TLS profiles are used.

        config APP_MQTT_TASK_PRIORITY
            int "MQTT manager task priority"
            range 1 20
            default 5
            help
                FreeRTOS priority of the MQTT manager task.

    endmenu

    menu "Web Portal"

        config APP_WEB_CALIB_ENABLE
            bool "Expose meter calibration in the config portal"
            default n
            help
                Adds the Calibration section and the /api/calib/profile and
                /api/calib/auto endpoints to the config portal.

                Leave OFF for production builds. Calibration writes gain and
                offset registers on the metering chip, so it is a developer
                function: with this disabled the endpoints are not compiled in
                and cannot be reached by anyone who opens the portal, which is a
                stronger guarantee than hiding a link. Console calibration
                (meter-cal ...) is unaffected and always available.

                Turn ON only for an engineering build, or when the calibration
                UI is moved behind the engineering-mode portal.

    endmenu

endmenu
